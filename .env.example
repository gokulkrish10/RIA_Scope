# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit the resulting .env or expose this token through VITE_ / NEXT_PUBLIC_.
RIA_WRITE_TOKEN=
RIA_DATA_DIR=.data/ria
PORT=4010
# Explicitly opt in; otherwise only manually triggered jobs run.
RIA_SCHEDULER_ENABLED=false
