# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit the resulting .env or expose this token through VITE_ / NEXT_PUBLIC_.
RIA_WRITE_TOKEN=
RIA_DATA_DIR=.data/ria
PORT=4010
# Explicitly opt in; otherwise only manually triggered jobs run.
RIA_SCHEDULER_ENABLED=false
# Structured analysis is enabled by default; false keeps text-only ingestion available.
RIA_ANALYSIS_ENABLED=true
# A trusted server-side reviewer UUID is required for review writes. Never accept it from a browser header.
RIA_REVIEWER_ID=
# Temporary credentials only, loaded explicitly by the worker. Never use VITE_/NEXT_PUBLIC_ prefixes.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional UTC expiry: preflight rejects expired credentials; AWS also enforces session expiry.
AWS_CREDENTIAL_EXPIRATION=
AWS_REGION=
# Must support Converse forced tool choice and match the configured region/inference profile.
BEDROCK_MODEL_ID=

# Local authenticated frontend gateway; browser uses this separate operator account.
RIA_FRONTEND_USER=gokul
RIA_FRONTEND_PASSWORD=
RIA_API_ORIGIN=http://127.0.0.1:4010
